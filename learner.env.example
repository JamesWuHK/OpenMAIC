# Copy to a private env file outside version control, then replace placeholders.
# Do not commit real credentials.

# This release requires PostgreSQL at boot. Set a long random password in a
# private learner.postgres.env (POSTGRES_PASSWORD=...) and use the exact same
# URL-encoded password below. Never commit either private file.
# Published classrooms still come from the read-only mounted files, not this DB.
DATABASE_URL=postgres://openmaic:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/openmaic

# Optional site access gate. Leave blank only for a deliberately public site.
ACCESS_CODE=

# Learner mode is also pinned by docker-compose.learner.yml. These entries make
# the intended deployment explicit for non-Compose tooling.
OPENMAIC_DEPLOYMENT_MODE=learner
NEXT_PUBLIC_OPENMAIC_DEPLOYMENT_MODE=learner
# Optional runtime publication catalog override.
LEARNER_PUBLISHED_COURSES_PATH=/app/content/learner/published-courses.json
# Server-side discussion model using OpenRouter's zero-cost free-model router.
# It selects an available free model that supports the request's required
# features; model choice and availability can vary, and free endpoints may be
# rate-limited. Use a specific paid model only after setting a spending limit.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=openrouter/free
DEFAULT_MODEL=openrouter:openrouter/free

# Protects /review/submissions and its review APIs. Use a long random value.
TEACHER_REVIEW_KEY=
TEACHER_SUBMISSIONS_PATH=/app/data/teacher-submissions
OPENMAIC_TEACHER_GENERATION_ENABLED=false
# Hosted OpenMAIC access code. Keep server-side only; never expose as NEXT_PUBLIC_*.
OPENMAIC_HOSTED_ACCESS_CODE=
